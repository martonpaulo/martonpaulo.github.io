---
import "../styles/global.css";

import { Font } from "astro:assets";

import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { getLinks, getPerson, getSite } from "../lib/db";

interface Props {
  /** Page title without the site suffix. Omit for the home page. */
  title?: string;
  description: string;
  /** Path of the Open Graph image, generated by src/pages/og/[id].png.ts. */
  ogImage?: string;
  ogType?: "website" | "article";
  /** Extra JSON-LD objects for this page. The Person and WebSite nodes are always emitted. */
  jsonLd?: Record<string, unknown>[];
}

const site = await getSite();
const person = await getPerson();
const links = await getLinks();

const {
  title,
  description,
  ogImage = "/og/site.png",
  ogType = "website",
  jsonLd = [],
} = Astro.props;

const fullTitle = title ? `${title} · ${site.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

const sameAs = links
  .filter((link) => !link.data.url.startsWith("mailto:") && link.data.id !== "cv")
  .map((link) => link.data.url);
const email = links.find((link) => link.data.url.startsWith("mailto:"))?.data.url;

const graph = [
  {
    "@type": "Person",
    "@id": `${site.url}/#person`,
    name: person.name,
    givenName: person.givenName,
    jobTitle: person.role,
    url: site.url,
    email,
    sameAs,
    address: { "@type": "PostalAddress", addressCountry: person.location },
    knowsLanguage: person.languages.map((language) => language.name),
  },
  {
    "@type": "WebSite",
    "@id": `${site.url}/#website`,
    url: site.url,
    name: site.title,
    description: site.description,
    inLanguage: site.locale,
    author: { "@id": `${site.url}/#person` },
  },
  ...jsonLd,
];
---

<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={person.name} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f1ea" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#13151e" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    {site.twitter && <meta name="twitter:site" content={site.twitter} />}
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <Font
      cssVariable="--font-serif"
      preload={[{ weight: 400, style: "normal", subset: "latin" }]}
    />
    <Font cssVariable="--font-sans" preload={[{ weight: 400, style: "normal", subset: "latin" }]} />
    <Font cssVariable="--font-mono" />

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({ "@context": "https://schema.org", "@graph": graph })}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="frame">
      <Header siteName={site.name} />
      <main id="main" class="main">
        <slot />
      </main>
      <Footer person={person} links={links} repository={site.repository} />
    </div>
  </body>
</html>

<style>
  .frame {
    width: min(100% - 2 * var(--gutter), var(--measure));
    margin-inline: auto;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .main {
    padding: var(--space-6) 0 var(--space-7);
  }
</style>

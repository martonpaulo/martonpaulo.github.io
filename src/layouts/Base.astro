---
import "../styles/global.scss";
import "./Base.scss";

import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";

import Footer from "../components/Footer.astro";
import Nav from "../components/Nav.astro";
import { getCopy, getLinks, getPerson, getSite } from "../lib/db";
import { jsonLdGraph, personNode, websiteNode, type JsonLdNode } from "../lib/seo";
import { pageTitle, shareImage } from "../lib/pages";

/**
 * Every page's frame: the <head> with all SEO surfaces, the navigation, the
 * main landmark and the contact footer. Pages pass their description and the
 * share image; they never write <head> tags themselves.
 */
interface Props {
  /** Page title without the site suffix. Omit for the home page. */
  title?: string | undefined;
  description: string;
  /** Path of the Open Graph image, generated by src/pages/og/[id].png.ts. */
  ogImage?: string | undefined;
  ogType?: "website" | "article";
  /** Extra JSON-LD nodes. The Person and WebSite nodes are always emitted. */
  jsonLd?: JsonLdNode[];
}

const site = await getSite();
const person = await getPerson();
const links = await getLinks();
const { nav } = await getCopy();

const { title, description, ogImage, ogType = "website", jsonLd = [] } = Astro.props;

const fullTitle = pageTitle(site, title);
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(shareImage(ogImage), Astro.site);
const graph = jsonLdGraph([personNode(site, person, links), websiteNode(site), ...jsonLd]);
---

<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={person.name} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1f302b" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    {site.twitter && <meta name="twitter:site" content={site.twitter} />}
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <Font
      cssVariable="--font-display"
      preload={[{ weight: 700, style: "normal", subset: "latin" }]}
    />
    <Font cssVariable="--font-body" preload={[{ weight: 400, style: "normal", subset: "latin" }]} />

    <script type="application/ld+json" is:inline set:html={graph} />
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">{nav.skip}</a>
    <div class="page-glow" aria-hidden="true" transition:persist="glow"></div>
    <Nav />
    <main id="main" class="page-main container" transition:animate="fade">
      <slot />
    </main>
    <Footer />
  </body>
</html>

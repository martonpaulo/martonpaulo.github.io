---
import "../styles/pages/home.scss";

import Button from "../components/Button.astro";
import Hero from "../components/Hero.astro";
import ProjectGrid from "../components/ProjectGrid.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Base from "../layouts/Base.astro";
import { fill } from "../lib/copy";
import { getCopy, getFeaturedProjects, getPerson, getSite } from "../lib/db";

const site = await getSite();
const person = await getPerson();
const { home } = await getCopy();
const featured = await getFeaturedProjects();
const eyebrow = fill(home.eyebrow, { name: person.name, role: person.role });
---

<Base description={site.description}>
  <Hero eyebrow={eyebrow} title={home.greeting} lede={person.intro} />

  <section class="section" aria-labelledby="featured-heading">
    <h2 id="featured-heading" class="visually-hidden">{home.featuredHeading}</h2>
    <ProjectGrid projects={featured} />
    <p class="home__more actions">
      <Button href="/work/">{home.allWork}</Button>
    </p>
  </section>

  <section class="section" aria-labelledby="now-heading">
    <SectionHeading id="now-heading" title={home.nowHeading} />
    <ul class="home__now" role="list">
      {person.now.map((item) => <li>{item}</li>)}
    </ul>
    <p class="home__more actions">
      <Button href="/about/">{home.moreAbout}</Button>
    </p>
  </section>
</Base>

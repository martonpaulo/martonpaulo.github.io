---
import "../styles/pages/about.scss";

import DefinitionList from "../components/DefinitionList.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import Base from "../layouts/Base.astro";
import { fill } from "../lib/copy";
import { getCopy, getPerson } from "../lib/db";
import { shareImageFor } from "../lib/pages";
import { languageRows, stackRows } from "../lib/person";

const person = await getPerson();
const { about } = await getCopy();
const [lead, ...rest] = person.bio;
const title = fill(about.title, { givenName: person.givenName });
const description = fill(about.description, {
  name: person.name,
  role: person.role.toLowerCase(),
  location: person.location,
});
---

<Base title={title} description={description} ogImage={shareImageFor("about")}>
  <Hero title={title} lede={lead} />

  <div class="about">
    <section class="section prose" aria-label={about.biographyLabel}>
      {rest.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <section class="section" aria-labelledby="now-heading">
      <SectionHeading id="now-heading" title={about.nowHeading} />
      <ul class="about__list" role="list">
        {person.now.map((item) => <li class="about__item">{item}</li>)}
      </ul>
    </section>

    <section class="section" aria-labelledby="stack-heading">
      <SectionHeading id="stack-heading" title={about.stackHeading} />
      <DefinitionList rows={stackRows(person)} />
    </section>

    <section class="section" aria-labelledby="languages-heading">
      <SectionHeading id="languages-heading" title={about.languagesHeading} />
      <DefinitionList rows={languageRows(person)} />
    </section>

    <section class="section prose" aria-labelledby="interests-heading">
      <SectionHeading id="interests-heading" title={about.interestsHeading} />
      {person.interests.map((paragraph) => <p>{paragraph}</p>)}
    </section>
  </div>
</Base>

---
import Hero from "../../components/Hero.astro";
import ProjectList from "../../components/ProjectList.astro";
import WorkFilters from "../../components/WorkFilters.astro";
import { projectKinds } from "../../content.config";
import Base from "../../layouts/Base.astro";
import { byYear, getCopy, getProjects } from "../../lib/db";
import { countByKind } from "../../lib/projects";

const projects = await getProjects();
const { projects: copy } = await getCopy();
// One list: the selected projects first, in their authored order, then everything else by year.
const listed = [
  ...projects.filter((project) => project.featured),
  ...byYear(projects.filter((project) => !project.featured)),
];
const counts = countByKind(projects, projectKinds);
---

<Base title={copy.title} description={copy.description}>
  <Hero title={copy.title} lede={copy.lede} />

  <WorkFilters current="all" counts={counts} />

  <section class="section" aria-labelledby="list-heading">
    <h2 id="list-heading" class="visually-hidden">{copy.listHeading}</h2>
    <ProjectList projects={listed} />
  </section>
</Base>

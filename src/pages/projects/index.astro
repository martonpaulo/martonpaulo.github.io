---
import "../../styles/pages/projects.scss";

import Hero from "../../components/Hero.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
import ProjectList from "../../components/ProjectList.astro";
import WorkFilters from "../../components/WorkFilters.astro";
import { projectKinds } from "../../content.config";
import Base from "../../layouts/Base.astro";
import { byYear, getCopy, getProjects } from "../../lib/db";
import { countByKind } from "../../lib/projects";

const projects = await getProjects();
const { projects: copy } = await getCopy();
const featured = projects.filter((project) => project.featured);
const archive = byYear(projects.filter((project) => !project.featured));
const counts = countByKind(projects, projectKinds);
---

<Base title={copy.title} description={copy.description}>
  <Hero title={copy.title} lede={copy.lede} />

  <WorkFilters current="all" counts={counts} />

  <section class="section" aria-labelledby="featured-heading">
    <h2 id="featured-heading" class="visually-hidden">{copy.featuredHeading}</h2>
    <ProjectGrid projects={featured} />
  </section>

  <section class="section" aria-labelledby="archive-heading">
    <h2 id="archive-heading" class="projects__archive-heading">{copy.archiveHeading}</h2>
    <ProjectList projects={archive} />
  </section>
</Base>

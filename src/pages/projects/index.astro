---
import Hero from "../../components/Hero.astro";
import ProjectList from "../../components/ProjectList.astro";
import WorkFilters from "../../components/WorkFilters.astro";
import { projectKinds } from "../../content.config";
import Base from "../../layouts/Base.astro";
import { getCopy, getCurrentProjects, homeFirst } from "../../lib/db";
import { countByKind, projectHeroes, projectRow } from "../../lib/projects";

const projects = await getCurrentProjects();
const allCopy = await getCopy();
const { projects: copy, kinds } = allCopy;
// One list of current projects: the home page's six first, then everything else by year.
// Earlier work has its own tab (#42).
const listed = (await homeFirst(projects)).map((project) => projectRow(project, kinds));
const counts = countByKind(projects, projectKinds);
---

<Base title={copy.title} description={copy.description}>
  <Hero title={copy.title} lede={copy.lede} reserve={projectHeroes(counts, allCopy)} />

  <WorkFilters current="all" counts={counts} />

  <section class="section" aria-labelledby="list-heading">
    <h2 id="list-heading" class="visually-hidden">{copy.listHeading}</h2>
    <ProjectList items={listed} />
  </section>
</Base>

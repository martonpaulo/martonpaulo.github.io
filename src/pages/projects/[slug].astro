---
import "../../styles/pages/project.scss";

import { Image } from "astro:assets";

import Button from "../../components/Button.astro";
import DefinitionList from "../../components/DefinitionList.astro";
import Eyebrow from "../../components/Eyebrow.astro";
import Base from "../../layouts/Base.astro";
import { byYear, getCopy, getProjects, getSite } from "../../lib/db";
import { heroImageSizes, heroImageWidths, imageQuality } from "../../lib/images";
import { shareImageFor } from "../../lib/pages";
import {
  projectDescription,
  projectLinks,
  projectMetaRows,
  projectPath,
  siblingsOf,
  tileFor,
} from "../../lib/projects";
import { softwareNode } from "../../lib/seo";

export async function getStaticPaths() {
  const projects = byYear(await getProjects());
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: { project, ...siblingsOf(projects, index) },
  }));
}

const { project, newer, older } = Astro.props;
const site = await getSite();
const copy = (await getCopy()).project;
const kindLabel = (await getCopy()).kinds[project.kind].one;
const links = projectLinks(project, copy);
const description = projectDescription(project, copy, site.name);
---

<Base
  title={project.name}
  description={description}
  ogImage={shareImageFor(project.slug)}
  ogType="article"
  jsonLd={[softwareNode(site, project)]}
>
  <article class="project">
    <header class="project__header stack-center">
      <Eyebrow as="p">{kindLabel}</Eyebrow>
      <h1 class="project__title">{project.name}</h1>
      <p class="lede">{project.tagline}</p>
      {
        (links.length > 0 || project.note) && (
          <div class="project__actions actions">
            {links.map((link, index) => (
              <Button href={link.url} variant={index === 0 ? "primary" : "quiet"} external>
                {link.label}
              </Button>
            ))}
            {project.note && <p class="muted">{project.note}</p>}
          </div>
        )
      }
    </header>

    {
      project.image && (
        <figure
          class:list={["project__art", `project__art--${project.image.fit}`]}
          style={`--tile: var(--tile-${tileFor(project, 0)})`}
        >
          <Image
            src={project.image.src}
            alt={project.image.alt}
            widths={heroImageWidths}
            sizes={heroImageSizes}
            quality={imageQuality}
            loading="eager"
          />
        </figure>
      )
    }

    <div class="project__body">
      <p class="prose">{project.description}</p>
      <DefinitionList rows={projectMetaRows(project, copy)} />
    </div>
  </article>

  <nav class="project__siblings" aria-label={copy.siblingsLabel}>
    {
      newer && (
        <a href={projectPath(newer)} class="project__sibling">
          <span class="project__sibling-label">{copy.newer}</span>
          <span class="project__sibling-name">{newer.name}</span>
        </a>
      )
    }
    {
      older && (
        <a href={projectPath(older)} class="project__sibling project__sibling--older">
          <span class="project__sibling-label">{copy.older}</span>
          <span class="project__sibling-name">{older.name}</span>
        </a>
      )
    }
  </nav>
</Base>

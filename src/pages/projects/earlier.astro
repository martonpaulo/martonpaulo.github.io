---
import ProjectTabs from "../../components/ProjectTabs.astro";
import Base from "../../layouts/Base.astro";
import { getCopy, getCurrentProjects, getEarlier, getProjects, getSite } from "../../lib/db";
import { earlierRow } from "../../lib/earlier";
import { countBySubject, tabNotes } from "../../lib/projects";

// Retired, old and study projects, newest first, each linking to its frozen build (#42).
// Not indexed: the page asks for noindex and astro.config.ts keeps it out of the sitemap.
const site = await getSite();
const allCopy = await getCopy();
const { earlier: copy, kinds } = allCopy;
const projects = await getProjects();
const counts = countBySubject(await getCurrentProjects());
const items = (await getEarlier()).map((entry) => earlierRow(entry, projects, site.archive, kinds));
---

<Base title={copy.title} description={copy.description} noindex>
  <ProjectTabs
    title={allCopy.projects.title}
    lede={allCopy.projects.lede}
    current="earlier"
    counts={counts}
    note={copy.note}
    notes={tabNotes(counts, allCopy)}
    listHeading={copy.listHeading}
    items={items}
  />
</Base>

---
import ProjectTabs from "../../../components/ProjectTabs.astro";
import { projectKinds } from "../../../content.config";
import Base from "../../../layouts/Base.astro";
import { fill } from "../../../lib/copy";
import { getCopy, getCurrentProjects, homeFirst } from "../../../lib/db";
import {
  countByKind,
  kindInSentence,
  kindNote,
  type ProjectKind,
  projectRow,
  tabNotes,
} from "../../../lib/projects";

export async function getStaticPaths() {
  const projects = await getCurrentProjects();
  return projectKinds
    .filter((kind) => projects.some((project) => project.kinds.includes(kind)))
    .map((kind) => ({ params: { kind } }));
}

const kind = Astro.params.kind as ProjectKind;
const projects = await getCurrentProjects();
const allCopy = await getCopy();
const { projects: copy, kinds } = allCopy;
const counts = countByKind(projects, projectKinds);

const ofKind = projects.filter((project) => project.kinds.includes(kind));
// One list, as on the projects page: the home page's ones first, then the rest by year.
const listed = (await homeFirst(ofKind)).map((project) => projectRow(project, kinds));
const vars = { kind: kindInSentence(kind, kinds) };
---

<Base title={kinds[kind].many} description={fill(copy.kindDescription, vars)}>
  <ProjectTabs
    title={copy.title}
    lede={copy.lede}
    current={kind}
    counts={counts}
    note={kindNote(kind, copy, kinds)}
    notes={tabNotes(counts, allCopy)}
    listHeading={fill(copy.kindListHeading, vars)}
    items={listed}
  />
</Base>

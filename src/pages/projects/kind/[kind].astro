---
import Hero from "../../../components/Hero.astro";
import ProjectGrid from "../../../components/ProjectGrid.astro";
import ProjectList from "../../../components/ProjectList.astro";
import WorkFilters from "../../../components/WorkFilters.astro";
import { projectKinds } from "../../../content.config";
import Base from "../../../layouts/Base.astro";
import { byYear, getCopy, getProjects } from "../../../lib/db";
import { fill, lowerFirst } from "../../../lib/copy";
import { countByKind, type ProjectKind } from "../../../lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projectKinds
    .filter((kind) => projects.some((project) => project.kind === kind))
    .map((kind) => ({ params: { kind } }));
}

const kind = Astro.params.kind as ProjectKind;
const projects = await getProjects();
const { projects: copy, kinds } = await getCopy();
const counts = countByKind(projects, projectKinds);

const ofKind = projects.filter((project) => project.kind === kind);
const featured = ofKind.filter((project) => project.featured);
const rest = byYear(ofKind.filter((project) => !project.featured));
const label = kinds[kind].many;
const vars = { kind: lowerFirst(label) };
---

<Base title={label} description={fill(copy.kindDescription, vars)}>
  <Hero title={fill(copy.kindTitle, { kind: label })} lede={fill(copy.kindLede, vars)} />

  <WorkFilters current={kind} counts={counts} />

  {
    featured.length > 0 && (
      <section class="section" aria-labelledby="featured-heading">
        <h2 id="featured-heading" class="visually-hidden">
          {fill(copy.kindFeaturedHeading, vars)}
        </h2>
        <ProjectGrid projects={featured} />
      </section>
    )
  }

  {
    rest.length > 0 && (
      <section class="section" aria-labelledby="archive-heading">
        <h2 id="archive-heading" class="visually-hidden">
          {fill(copy.kindArchiveHeading, vars)}
        </h2>
        <ProjectList projects={rest} />
      </section>
    )
  }
</Base>

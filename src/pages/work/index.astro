---
import "../../styles/pages/work.scss";

import Hero from "../../components/Hero.astro";
import ProjectGrid from "../../components/ProjectGrid.astro";
import ProjectList from "../../components/ProjectList.astro";
import WorkFilters from "../../components/WorkFilters.astro";
import { projectKinds } from "../../content.config";
import Base from "../../layouts/Base.astro";
import { byYear, getCopy, getProjects } from "../../lib/db";
import { shareImageFor } from "../../lib/pages";
import { countByKind } from "../../lib/projects";

const projects = await getProjects();
const { work } = await getCopy();
const featured = projects.filter((project) => project.featured);
const archive = byYear(projects.filter((project) => !project.featured));
const counts = countByKind(projects, projectKinds);
---

<Base title={work.title} description={work.description} ogImage={shareImageFor("work")}>
  <Hero title={work.title} lede={work.lede} />

  <WorkFilters current="all" counts={counts} />

  <section class="section" aria-labelledby="featured-heading">
    <h2 id="featured-heading" class="visually-hidden">{work.featuredHeading}</h2>
    <ProjectGrid projects={featured} />
  </section>

  <section class="section" aria-labelledby="archive-heading">
    <h2 id="archive-heading" class="work__archive-heading">{work.archiveHeading}</h2>
    <ProjectList projects={archive} />
  </section>
</Base>

---
import "./WorkFilters.scss";

import { getCopy } from "../lib/db";
import { filterOptions, type KindCounts, type ProjectKind } from "../lib/projects";

/** Pill chips that narrow the archive to one kind; each chip is a real page. */
interface Props {
  current: "all" | ProjectKind;
  counts: KindCounts;
}

const { current, counts } = Astro.props;
const { work, kinds } = await getCopy();
const options = filterOptions(counts, work.filterAll, kinds);
---

<nav class="work-filters" aria-label={work.filterLabel}>
  <ul class="actions" role="list">
    {
      options.map((option) => (
        <li>
          <a
            class="work-filters__chip"
            href={option.href}
            aria-current={option.key === current ? "page" : undefined}
          >
            {option.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

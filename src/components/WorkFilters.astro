---
import "./WorkFilters.scss";

import { getCopy } from "../lib/db";
import { type FilterKey, filterOptions, type KindCounts } from "../lib/projects";

/**
 * The tab row, in three groups (#43): Everything, set apart as the whole list; one chip per
 * platform; then Earlier work. A divider closes the first group and opens the last. Each chip is
 * a real page, and the current one looks the same whichever it is.
 */
interface Props {
  current: FilterKey;
  counts: KindCounts;
}

const { current, counts } = Astro.props;
const { projects: copy, kinds, earlier } = await getCopy();
const options = filterOptions(counts, copy.filterAll, kinds, earlier.tab);
---

<nav class="work-filters" aria-label={copy.filterLabel}>
  <ul class="actions" role="list">
    {
      options.map((option) => (
        <li class:list={["work-filters__item", `work-filters__item--${option.group}`]}>
          <a
            class:list={["work-filters__chip", `work-filters__chip--${option.group}`]}
            href={option.href}
            aria-current={option.key === current ? "page" : undefined}
          >
            {option.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

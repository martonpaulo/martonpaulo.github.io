---
import { kindLabelsPlural, type Project } from "../lib/db";

interface Props {
  current: "all" | Project["kind"];
}

const { current } = Astro.props;

const options: { key: Props["current"]; label: string; href: string }[] = [
  { key: "all", label: "everything", href: "/work/" },
  ...(Object.keys(kindLabelsPlural) as Project["kind"][]).map((kind) => ({
    key: kind,
    label: kindLabelsPlural[kind],
    href: `/work/kind/${kind}/`,
  })),
];
---

<nav class="filters" aria-label="Filter by kind">
  <span class="label">show</span>
  <ul>
    {
      options.map((option) => (
        <li>
          <a href={option.href} aria-current={option.key === current ? "page" : undefined}>
            {option.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    margin-top: var(--space-5);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-3);
  }

  .label::before {
    content: "[ ";
  }

  .label::after {
    content: " ]";
  }

  ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
  }

  a {
    text-decoration: none;
    color: var(--ink-3);
  }

  a:hover {
    color: var(--accent);
  }

  a[aria-current="page"] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.3em;
  }
</style>

---
import Mark from "./Mark.astro";

interface Props {
  siteName: string;
}

const { siteName } = Astro.props;
const path = Astro.url.pathname;

const items = [
  { href: "/work/", label: "Work", current: path.startsWith("/work/") },
  { href: "/about/", label: "About", current: path.startsWith("/about/") },
  { href: "#contact", label: "Contact", current: false },
];
---

<header class="header">
  <a class="brand" href="/" aria-label={`${siteName}, home`}>
    <Mark />
    <span class="brand-name">{siteName.toLowerCase()}</span>
  </a>
  <nav aria-label="Main">
    <ul class="nav">
      {
        items.map((item) => (
          <li>
            <a href={item.href} aria-current={item.current ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4) 0;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }

  .brand:hover {
    color: inherit;
  }

  .brand-name {
    letter-spacing: -0.01em;
  }

  .nav {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    font-size: var(--text-sm);
  }

  .nav a {
    text-decoration: none;
    color: var(--ink-2);
  }

  .nav a:hover,
  .nav a[aria-current="page"] {
    color: var(--ink);
  }

  .nav a[aria-current="page"] {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.35em;
  }

  @media (max-width: 24rem) {
    .brand-name {
      display: none;
    }
  }
</style>

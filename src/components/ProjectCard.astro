---
import "./ProjectCard.scss";

import { Image } from "astro:assets";

import { getCopy } from "../lib/db";
import { cardImageSizes, cardImageWidths, imageQuality, isEagerCard } from "../lib/images";
import { projectPath, tileFor, type Project } from "../lib/projects";
import Eyebrow from "./Eyebrow.astro";

/**
 * A project as a pastel tile: kind, name, one line, and its artwork bleeding
 * out of the bottom. The whole tile is one link named by the project name
 * alone, so listing the page's links reads as a list of projects rather than
 * of paragraphs; the artwork is decorative because the text already says it.
 *
 * Two layers, because one element cannot both clip its contents and paint
 * outside itself: the link paints the focus ring and the shadow, and the
 * surface inside it holds the tile and clips the artwork to the corner.
 */
interface Props {
  project: Project;
  index: number;
  headingLevel?: "h2" | "h3";
}

const { project, index, headingLevel: Heading = "h3" } = Astro.props;
const { kinds } = await getCopy();
const tile = tileFor(project, index);
const art = project.image;
// The link points at its own heading rather than repeating the name, so the
// copy keeps one owner and the accessible name is the visible one.
const titleId = `project-card-title-${project.slug}`;
---

<a
  class="project-card"
  href={projectPath(project)}
  aria-labelledby={titleId}
  style={`--tile: var(--tile-${tile})`}
>
  <div class="project-card__surface">
    <div class="project-card__info">
      <Eyebrow class="project-card__kind">{kinds[project.kind].one}</Eyebrow>
      <Heading class="project-card__title" id={titleId}>{project.name}</Heading>
      <p class="project-card__tagline">{project.tagline}</p>
    </div>
    {
      art && (
        <div class:list={["project-card__art", `project-card__art--${art.fit}`]}>
          <Image
            src={art.src}
            alt=""
            widths={cardImageWidths}
            sizes={cardImageSizes(art.fit)}
            quality={imageQuality}
            loading={isEagerCard(index) ? "eager" : "lazy"}
            decoding="async"
          />
        </div>
      )
    }
  </div>
</a>

---
import "./ProjectRow.scss";

import { Image } from "astro:assets";

import { getCopy } from "../lib/db";
import { ROW_ICON_SIZE } from "../lib/images";
import { externalLinkAttributes } from "../lib/links";
import type { RowItem } from "../lib/projects";

/** A project as one line in a list: its icon, name, what it does, kind and year or period. */
interface Props {
  item: RowItem;
  headingLevel?: "h2" | "h3";
}

const { item, headingLevel: Heading = "h3" } = Astro.props;
const linkAttributes = item.external ? externalLinkAttributes : {};
const { nav } = await getCopy();
---

<article class:list={["project-row", { "project-row--retired": item.retired }]}>
  {
    /* The icon leads to the same page as the name. It is a second link to one
       destination, so it is hidden from assistive technology and skipped by the
       keyboard: the name is the one stop, and the icon is the larger target a
       pointer finds first. */
  }
  <a
    class="project-row__icon-link"
    href={item.href}
    tabindex="-1"
    aria-hidden="true"
    {...linkAttributes}
  >
    <Image
      class="project-row__icon"
      src={item.icon}
      alt=""
      width={ROW_ICON_SIZE}
      height={ROW_ICON_SIZE}
      densities={[1, 2]}
      loading="lazy"
      decoding="async"
    />
  </a>
  <div class="project-row__text">
    <Heading class="project-row__title">
      <a href={item.href} {...linkAttributes}>
        {item.name}
        {
          item.external && (
            <>
              <span class="project-row__arrow" aria-hidden="true">
                ↗
              </span>
              <span class="visually-hidden">
                {item.external === "site" ? nav.newTabSite : nav.newTab}
              </span>
            </>
          )
        }
      </a>
    </Heading>
    <p class="project-row__tagline">{item.tagline}</p>
  </div>
  <ul class="project-row__meta" role="list">
    {/* Each platform the project runs on, then the year, one per line, no divider (#55). */}
    {item.kinds.map((kind) => <li>{kind}</li>)}
    <li>{item.when}</li>
  </ul>
</article>

---
import "./ProjectRow.scss";

import { Image } from "astro:assets";

import { getCopy } from "../lib/db";
import { projectIcon, ROW_ICON_SIZE } from "../lib/images";
import { kindLabel, projectPath, type Project } from "../lib/projects";

/** A project as one line in the list: its icon, name, what it does, kind and year. */
interface Props {
  project: Project;
  headingLevel?: "h2" | "h3";
}

const { project, headingLevel: Heading = "h3" } = Astro.props;
const { kinds } = await getCopy();
const icon = projectIcon(project.slug);
---

<article class="project-row">
  {
    icon && (
      <Image
        class="project-row__icon"
        src={icon}
        alt=""
        width={ROW_ICON_SIZE}
        height={ROW_ICON_SIZE}
        densities={[1, 2]}
        loading="lazy"
        decoding="async"
      />
    )
  }
  <div class="project-row__text">
    <Heading class="project-row__title"><a href={projectPath(project)}>{project.name}</a></Heading>
    <p class="project-row__tagline">{project.tagline}</p>
  </div>
  <p class="project-row__meta">
    <span>{kindLabel(project, kinds)}</span>
    <span aria-hidden="true">·</span>
    <span>{project.year}</span>
  </p>
</article>

---
import "./ProjectRow.scss";

import { Image } from "astro:assets";

import { getCopy } from "../lib/db";
import { projectIcon, ROW_ICON_SIZE } from "../lib/images";
import { kindPath, projectPath, type Project } from "../lib/projects";

/** A project as one line in the list: its icon, name, what it does, kind and year. */
interface Props {
  project: Project;
  headingLevel?: "h2" | "h3";
}

const { project, headingLevel: Heading = "h3" } = Astro.props;
const { kinds } = await getCopy();
const icon = projectIcon(project.slug);
const href = projectPath(project);
---

<article class="project-row">
  {
    /* The icon leads to the same page as the name. It is a second link to one
       destination, so it is hidden from assistive technology and skipped by the
       keyboard: the name is the one stop, and the icon is the larger target a
       pointer finds first. */
    icon && (
      <a class="project-row__icon-link" href={href} tabindex="-1" aria-hidden="true">
        <Image
          class="project-row__icon"
          src={icon}
          alt=""
          width={ROW_ICON_SIZE}
          height={ROW_ICON_SIZE}
          densities={[1, 2]}
          loading="lazy"
          decoding="async"
        />
      </a>
    )
  }
  <div class="project-row__text">
    <Heading class="project-row__title"><a href={href}>{project.name}</a></Heading>
    <p class="project-row__tagline">{project.tagline}</p>
  </div>
  <p class="project-row__meta">
    {
      /* Each kind is its own filter, so a project that is both an iOS and a
         macOS app offers both. */
      project.kinds.map((kind, index) => (
        <>
          {index > 0 && <span aria-hidden="true">·</span>}
          <a href={kindPath(kind)}>{kinds[kind].one}</a>
        </>
      ))
    }
    <span aria-hidden="true">·</span>
    <span>{project.year}</span>
  </p>
</article>

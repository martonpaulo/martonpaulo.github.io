---
import "./Footer.scss";

import { fill } from "../lib/copy";
import { getCopy, getLinks, getPerson, getSite } from "../lib/db";
import { isEmailLink, isExternalLink } from "../lib/links";
import Button from "./Button.astro";
import SectionHeading from "./SectionHeading.astro";

/** The contact block every page ends with, plus the colophon. */
const site = await getSite();
const person = await getPerson();
const links = await getLinks();
const { contact } = await getCopy();
const year = new Date().getFullYear();
---

<footer class="footer">
  <section class="container stack-center" id="contact" aria-labelledby="contact-heading">
    <SectionHeading
      id="contact-heading"
      title={contact.title}
      lede={fill(contact.lede, { givenName: person.givenName })}
    />
    <ul class="actions" role="list">
      {
        links.map((link) => (
          <li>
            <Button
              href={link.url}
              variant={isEmailLink(link) ? "primary" : "quiet"}
              external={isExternalLink(link)}
            >
              {link.label}
            </Button>
          </li>
        ))
      }
    </ul>
  </section>
  <p class="footer__colophon container">
    {fill(contact.colophon, { year, name: person.name })}
    <a href={site.repository} rel="noopener">{contact.sourceLink}</a>.
  </p>
</footer>

---
import "./Mark.scss";

/**
 * The bracket mark, carried over from the previous site's icon: two brackets
 * with an offset shadow. It is the only logo and it stays small.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 20, class: className } = Astro.props;
---

<svg
  class:list={["mark", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path class="mark__shadow" d="M10.5 4.5h-5v17h5M15.5 4.5h5v17h-5"></path>
  <path class="mark__ink" d="M9 3H4v17h5M16 3h5v17h-5"></path>
</svg>

---
/**
 * The bracket mark: two brackets with a hard offset shadow, carried over from
 * the previous site's icon. It reads as "a name held in code" and repeats as
 * the site's grammar (eyebrows, years, tags all sit in brackets).
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 22, class: className } = Astro.props;
---

<svg
  class:list={["mark", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <path
    class="mark-shadow"
    d="M10.5 4.5h-5v17h5M15.5 4.5h5v17h-5"
    stroke-width="2.4"
    stroke-linecap="square"></path>
  <path class="mark-ink" d="M9 3H4v17h5M16 3h5v17h-5" stroke-width="2.4" stroke-linecap="square"
  ></path>
</svg>

<style>
  .mark {
    flex: none;
    overflow: visible;
  }

  .mark-shadow {
    stroke: color-mix(in srgb, var(--accent) 28%, transparent);
    transition: transform var(--duration) var(--ease);
  }

  .mark-ink {
    stroke: var(--accent);
  }

  :global(a:hover) .mark-shadow {
    transform: translate(1px, 1px);
  }
</style>

---
import "./ProjectList.scss";

import type { RowItem } from "../lib/projects";
import ProjectRow from "./ProjectRow.astro";

interface Props {
  items: RowItem[];
  headingLevel?: "h2" | "h3";
}

const { items, headingLevel = "h3" } = Astro.props;
---

<div class="project-list">
  {items.map((item) => <ProjectRow item={item} headingLevel={headingLevel} />)}
</div>

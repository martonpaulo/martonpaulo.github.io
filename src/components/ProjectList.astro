---
import "./ProjectList.scss";

import type { Project } from "../lib/projects";
import ProjectRow from "./ProjectRow.astro";

interface Props {
  projects: Project[];
  headingLevel?: "h2" | "h3";
}

const { projects, headingLevel = "h3" } = Astro.props;
---

<div class="project-list">
  {projects.map((project) => <ProjectRow project={project} headingLevel={headingLevel} />)}
</div>

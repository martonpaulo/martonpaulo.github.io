{
  "name": "martonpaulo.github.io",
  "version": "0.0.0",
  "private": true,
  "description": "Marton Paulo's personal site: a static portfolio built with Astro from a few JSON files and published to GitHub Pages.",
  "author": {
    "name": "Marton Paulo",
    "email": "info@martonpaulo.com",
    "url": "https://martonpaulo.com"
  },
  "license": "MIT",
  "homepage": "https://martonpaulo.com",
  "repository": "github:martonpaulo/martonpaulo.github.io",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && prettier --check . && pnpm text-check",
    "text-check": "python3 scripts/text_check.py . && python3 scripts/issue_links.py . && python3 scripts/dry_check.py && python3 scripts/sleep_guard.py . && python3 scripts/shortcut_check.py .",
    "format": "prettier --write .",
    "test": "node --test",
    "archive-check": "node scripts/archive-check.mjs",
    "build-check": "node scripts/earlier-build-check.mjs dist",
    "validate": "pnpm check && pnpm lint && pnpm test && pnpm archive-check && pnpm kinds-check && pnpm build && pnpm build-check && pnpm text-width-check && pnpm layout-check",
    "share-ground": "pnpm dlx playwright@1.63.0 screenshot --viewport-size=1200,630 \"file://$PWD/scripts/share-home/ground.html\" src/assets/share/home-ground.png",
    "card-art": "node scripts/card-art/render.mjs",
    "card-gradients": "node scripts/card-art/gradients.mjs",
    "kinds-check": "node scripts/kinds.mjs --check",
    "layout-check": "node scripts/layout-check.mjs dist",
    "text-width-check": "python3 scripts/text_width_check.py src dist"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/gabarito": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.4.13",
    "satori": "^0.63.2",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "playwright-core": "1.63.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^0.14.1",
    "sass": "^1.108.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
